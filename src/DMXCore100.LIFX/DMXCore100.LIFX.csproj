<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The SDK generates manifest.json and PluginBuildInfo from these -->
    <PluginId>lifx</PluginId>
    <PluginDisplayName>LIFX</PluginDisplayName>
    <Version>1.1.0</Version>
    <Authors>DMX Core</Authors>

    <!-- Plugin registry (nuget.org) package metadata. DMXCore.Plugin.* is the
         reserved first-party prefix; the package is produced by `dotnet pack`
         via the DMXCore.PluginSdk pack targets. -->
    <PackageId>DMXCore.Plugin.LIFX</PackageId>
    <Description>LIFX output for the DMX Core 100 lighting controller: drives LIFX WiFi color bulbs and SuperColour / pixel fixtures from DMX channel data over the LIFX LAN protocol, no cloud account required.</Description>
    <PackageProjectUrl>https://docs.dmxcore.com/dmx-core-100</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Embedded icon (not iconUrl) is a nuget.org reserved-prefix review
         criterion; icon.png is the same 128x128 logo the SDK packages ship. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>lifx;lan;smart-lighting</PackageTags>
    <!-- No PluginMinSdkVersion override: this plugin uses 16-bit (fine)
         plugin fixture profile channels (SDK contract 1.8), so the derived
         floor (the contract we compile against) is the real requirement. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DMXCore100.LIFX.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets="runtime": the DMX Core 100 host provides the SDK (and
         its dependencies) at runtime and always resolves them to its own
         copies, so they must not be shipped inside the .dmxplugin. -->
    <PackageReference Include="DMXCore.PluginSdk" Version="1.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
