<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local feed for unpublished DMXCore.PluginSdk versions during
         development: pack the SDK from the Software repo with a package
         version HIGHER than the latest on nuget.org, e.g.
         dotnet pack src/PluginSdk -c Release -p:Version=1.8.0 -o <this repo>\local-feed
         (and src/PluginSdk.Testing likewise). The folder is committed
         (empty) so restore also works on CI, where everything comes from
         nuget.org. -->
    <add key="local" value="local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
